            "state" : "translated",
            "value" : "Kilometertal skal være mindre end eller lig med %1$@ %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilometerstand muss kleiner oder gleich %1$@ %2$@ sein."
          }

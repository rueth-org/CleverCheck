    "Mileage must be between %@ %@ and %@ %@." : {
      "comment" : "Error message when the mileage of a charging session is not within the mileage range of two previously saved charging sessions. The first argument is the mileage of the previous session. The second argument is the mileage of the next session.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilometertal skal være mellem %1$@ %2$@ og %3$@ %4$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilometerstand muss zwischen %1$@ %2$@ und %3$@ %4$@ liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mileage must be between %1$@ %2$@ and %3$@ %4$@."
          }
        }
      }
    },
    "Mileage must be between %1$@ and %2$@." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilometertallet skal være mellem %1$@ og %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilometerstand muss zwischen %1$@ und %2$@ liegen."
          }
        }
      }
    },
    "Mileage must be greater or equal than %@ %@." : {
      "comment" : "Error shown when a mileage is entered that is either less than or greater than the nearest previous or next mileage for a given charging plan. The first argument is the rounded value of the offending mileage. The second argument is the symbol of the mileage unit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilometerstanden skal være større end eller lig med %1$@ %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilometerstand muss größer oder gleich %1$@ %2$@ sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mileage must be greater or equal than %1$@ %2$@."
          }
        }
      }
    },
    "Mileage must be greater or equal than %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilometerstanden skal være større end eller lig med %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilometerstand muss größer oder gleich %@ sein."
          }
        }
      }
    },
    "Mileage must be less or equal than %@ %@." : {
      "comment" : "Error message when a charging session's mileage is entered that is greater than the mileage of the next session. The argument is the mileage value, formatted to the user's precision settings, and the second argument is the symbol of the mileage unit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "da" : {

      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et estimat af den opladede energi kræver en initial SOC, der er mindre end den finale SOC."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Abschätzung der geladenen Energie ist ein anfänglicher Ladestand (SOC) erforderlich, der kleiner ist als der finale Ladestand (SOC)."
          }
        }
      }
